{
  "name": "@braintied/watchtower-capture",
  "version": "5.0.1",
  "description": "Apache capture client for Watchtower. Your host, your database. Not Braintied Fly or Cortex.",
  "type": "module",
  "license": "Apache-2.0",
  "homepage": "https://github.com/braintied/watchtower",
  "repository": {
    "type": "git",
    "url": "https://github.com/braintied/watchtower.git"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "verify": "tsc --noEmit",
    "install-hooks": "tsx scripts/install-hooks.ts",
    "uninstall-hooks": "tsx scripts/uninstall-hooks.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@hono/node-server": "^1.13.0",
    "@supabase/supabase-js": "^2.99.1",
    "hono": "^4.12.8",
    "inngest": "^3.30.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  }
}
