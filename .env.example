# Your database. Not Braintied's. src/lib/db.ts throws if these are empty.
# Compose on the host: http://127.0.0.1:54321
# Compose in the app container: http://rest:3000
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Leftover analyzer only. Leave empty if you are only capturing.
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=

# Hooks. Localhost is the default. Do not set ora-watchtower.fly.dev.
WATCHTOWER_SESSION_WEBHOOK_URL=http://localhost:5003/webhooks/session
WATCHTOWER_SESSION_START_URL=http://localhost:5003/webhooks/session-start

PORT=5003
